# ============================================
# TurismoSearch - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=30

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL_HOURS=24

# --- IBGE API ---
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1
IBGE_TIMEOUT_SECONDS=10

# --- Nominatim (Geocoding OSM) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TurismoSearch/1.0
NOMINATIM_TIMEOUT_SECONDS=10

# --- App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Rate Limiting (proteção Claude API) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_REQUESTS_PER_HOUR=500
